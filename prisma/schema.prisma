generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// إعدادات البوت (نافذة الجلسات + سلم الأولويات + القواعد العليا + المؤشرات)
model BotSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  json      String
  updatedAt DateTime @updatedAt
}

// آخر نتيجة باك تيست محفوظة
model BacktestRun {
  id         String   @id @default(cuid())
  runAt      DateTime @default(now())
  tradesJson String
  statsJson  String
}

// وضع الظل Shadow Mode — كل إشارة حية تُسجل وتُتتبع نتائجها فعلياً
// (هل نفذت؟ ضربت الهدف أم الوقف؟) — أساس كاشف الانحراف بين الحي والباك تيست
model LiveSignal {
  id          String   @id @default(cuid())
  key         String   @unique // strategy-entry-createdAt لمنع التكرار
  createdAtMs Float
  strategy    String
  dir         String
  entry       Float
  sl          Float
  tp          Float
  session     String
  reason      String
  expiresAtMs Float
  score       Float    @default(0)
  status      String   @default("pending") // pending | filled | expired
  outcome     String?  // tp | sl | time | open
  filledAtMs  Float?
  closedAtMs  Float?
  pnlPips     Float?
  checkedAtMs Float?
}

// التنفيذ الحي على MT5 — كل أمر صادر من عقل القرار إلى الجسر وسير التنفيذ الفعلي
// (planned→sent→placed→filled→closed أو canceled/failed) — السجل الحصري للصفقات الحية
model LiveOrder {
  id          String   @id @default(cuid())
  planId      String   @unique // مفتاح الخطة: strategy-entry-createdAt — يمنع التكرار
  strategy    String
  dir         String   // buy | sell
  entry       Float
  sl          Float
  tp          Float
  lot         Float    @default(0.01)
  kind        String   @default("limit") // limit | market
  createdAtMs Float
  expiresAtMs Float
  status      String   @default("sent") // sent | placed | filled | closed | canceled | failed | expired
  ticket      String?  // تذكرة الأمر المعلق أو الصفقة في MT5 — نص لأن محرك Prisma/SQLite يفشل مع أي عدد يتجاوز نطاق Int32 حتى مع BigInt
  comment     String?  // تعليق الأمر في MT5 (TAMSA-<استراتيجية>-<بصمة الخطة>) — مفتاح المطابقة
  fillPrice   Float?
  closedAtMs  Float?
  closeReason String?  // tp | sl | timestop | daystop | manual | reconcile
  pnl         Float?
  error       String?
  magic       Float?
  updatedAtMs Float    @default(0)
  checkedAtMs Float    @default(0)
}
